{
  "name": "artis-and-you-desktop",
  "productName": "Artesa",
  "version": "1.3.0",
  "description": "Artesa — logiciel PC et Mac",
  "author": "Artesa",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^44.11.1",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "fr.artisandyou.app",
    "productName": "Artesa",
    "copyright": "© Artesa",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["main.js", "preload.js", "config.json", "offline.html", "build/icon.png"],
    "publish": [{ "provider": "github", "owner": "tomascdj0903", "repo": "artis-and-you", "releaseType": "release" }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "Artesa-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Artesa",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "language": "1036"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }, { "target": "zip", "arch": ["universal"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "artifactName": "Artesa.${ext}",
      "identity": null
    },
    "dmg": { "title": "Artesa" }
  }
}
